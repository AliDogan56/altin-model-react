APP_ENV=development
HOST=0.0.0.0
PORT=8003
AUTO_GENERATE=true
PIPELINE_MODE=full
CHECK_INTERVAL_SECONDS=300
TRIGGER_MOVE_PCT=0.5
MIN_INTERVAL_MINUTES=60
MAX_AGE_MINUTES=240
LLM_PAUSE_SECONDS=1
KEEP_VERSIONS=20
CORS_ORIGINS=https://api-dev.example.com
# Kota bütçesi: metin günde en çok 12, ses günde en çok 8 ve en sık 90 dk'da bir; 429'da 60 dk soğuma. Sayaç Pasifik gece yarısında sıfırlanır.
MAX_TEXT_RUNS_PER_DAY=12
MAX_NARRATIONS_PER_DAY=8
NARRATE_MIN_INTERVAL_MINUTES=90
NARRATE_RETRY_MINUTES=15
NARRATE_COOLDOWN_MINUTES=60
QUOTA_RESET_TZ=America/Los_Angeles
# Girdiler (takvim, faiz, enflasyon, pozisyon, makro seri, başlıklar) değişmediyse yalnız anlatıcı yeniden yazar; tam tur en geç bu kadar dakikada bir.
FULL_RUN_MAX_AGE_MINUTES=240
